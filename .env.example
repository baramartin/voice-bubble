# Easiest: run `npm run setup` and the wizard writes this file for you.

# At least one key is required; either provider alone is enough.
OPENAI_API_KEY=sk-your-api-key-here
# Gemini (has a free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Defaults the bubble starts with (you can change them anytime in the bubble's settings)
# DEFAULT_STT_ENGINE=gemini-3.5-transcribe   # or gpt-transcribe, gpt-4o-transcribe
# DEFAULT_STYLE=clean                        # Smart mode; or none (raw), no-newlines, professional, bullet-points, emojify, concise
# DEFAULT_TTS_ENGINE=gemini                  # or openai
# DEFAULT_TTS_VOICE=Kore                     # Gemini voice name, or an OpenAI voice like alloy

# Optional model overrides
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts   # or gemini-3.8-flash-tts
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite      # used for output styles when there's no OpenAI key

# Global hotkeys (Electron accelerator format)
# HOTKEY_DICTATE=Ctrl+Shift+Space
# HOTKEY_READ_ALOUD=Ctrl+Alt+Shift+Space

# Optional: comma-separated names/jargon to help Gemini transcription recognize them
# GEMINI_TRANSCRIBE_VOCABULARY=Kubernetes, BigQuery, Electron
